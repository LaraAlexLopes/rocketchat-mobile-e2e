{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/appium-service", "expect-webdriverio"]
  },
  "include": ["src", "test", "scripts", "wdio.conf.ts", "eslint.config.mjs", "commitlint.config.mjs"]
}
