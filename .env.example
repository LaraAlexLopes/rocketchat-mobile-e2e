# Rocket.Chat server as seen from the machine running the tests (API seeding/cleanup)
API_URL=http://localhost:3000

# Rocket.Chat server as seen from the Android emulator (10.0.2.2 = host machine)
APP_SERVER_URL=http://10.0.2.2:3000

# Admin credentials created by docker/docker-compose.yml on first boot
ADMIN_USERNAME=admin.e2e
ADMIN_PASSWORD=Admin@e2e123

# Device and app
DEVICE_NAME=emulator-5554
APK_PATH=apps/rocketchat.apk

# Prefix used to tag every record created by the tests (the sweeper deletes by this prefix)
DATA_PREFIX=qa
