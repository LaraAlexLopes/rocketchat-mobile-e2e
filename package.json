{
  "name": "rocketchat-mobile-e2e",
  "version": "1.0.0",
  "description": "End-to-end mobile test automation for the Rocket.Chat Android app with WebdriverIO, Appium and TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "server:up": "docker compose -f docker/docker-compose.yml up -d && bash scripts/wait-for-server.sh",
    "server:down": "docker compose -f docker/docker-compose.yml down -v",
    "app:download": "bash scripts/download-apk.sh",
    "appium:setup": "appium driver install uiautomator2 || appium driver update uiautomator2",
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "test:data": "mocha --node-option import=tsx --timeout 30000 'test/data/**/*.spec.ts'",
    "data:sweep": "tsx scripts/sweep.ts",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "mocha": "^11.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
